pkgname=ciigo-git
pkgver=0.18.0.r0.g2b35c68
pkgrel=1

pkgdesc="CLI to convert, generate, and/or serve AsciiDoc markup files as HTML files."
arch=(x86_64)
url='https://kilabit.info/project/ciigo/'
license=('GPL-3.0-only')

makedepends=(
	'go'
	'git'
)

provides=('ciigo')

source=(
	"$pkgname::git+https://git.kilabit.info/ciigo"
)

## For testing on local.
#pkgname=ciigo-local
#source=(
#	"$pkgname::git+file:///home/ms/go/src/kilabit.info/_project/src/ciigo"
#)

md5sums=(
	'SKIP'
)

pkgver() {
	cd "$pkgname"
	git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "$pkgname"
	make
}

package() {
	cd "$pkgname"
	install -Dm755 _bin/ciigo $pkgdir/usr/bin/ciigo
	install -Dm755 COPYING $pkgdir/usr/share/licenses/ciigo/COPYING
}
